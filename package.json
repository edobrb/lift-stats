{
  "name": "lift-stats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Track major lifts (pull-up, squat, bench, deadlift) with the phone camera. On-device pose tracking, frame-precise eccentric/concentric timing, fully offline.",
  "scripts": {
    "dev": "vite",
    "dev:https": "VITE_HTTPS=1 vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "esbuild scripts/check-rep-detector.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/check.mjs && node node_modules/.tmp/check.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  }
}
